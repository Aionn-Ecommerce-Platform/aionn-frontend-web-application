{
  "name": "aionn-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "Aionn - AI-powered e-commerce platform frontend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:cov": "vitest --run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "deadcode": "knip",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:api": "node scripts/check-api-contract.mjs",
    "check:i18n": "node scripts/check-ui-hardcodes.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "verify": "npm run check:encoding && npm run check:api && npm run check:i18n && npm run check:architecture && npm run check:design && npm run type-check && npm run lint && npm run test:cov && npm run deadcode && npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@tanstack/react-query": "^5.100.14",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.9.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "2.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "27.0.0",
    "knip": "5.64.1",
    "prettier": "3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
