# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080

# Browser authentication providers
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Browser payment provider
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shipping quote fallback parcel size (used when a product has no
# packageWeight/packageDimensions metadata). Keep in sync with the backend
# `shipping.default-dimensions` config.
NEXT_PUBLIC_SHIPPING_DEFAULT_WEIGHT_GRAM=500
NEXT_PUBLIC_SHIPPING_DEFAULT_LENGTH_CM=15
NEXT_PUBLIC_SHIPPING_DEFAULT_WIDTH_CM=10
NEXT_PUBLIC_SHIPPING_DEFAULT_HEIGHT_CM=5

# Repository tooling
AIONN_BACKEND_PATH=../aionn-modulith-backend

# Playwright overrides
E2E_FRONTEND_URL=http://127.0.0.1:3000
E2E_API_URL=http://127.0.0.1:8080/api/v1
E2E_EXTERNAL_FRONTEND=false
